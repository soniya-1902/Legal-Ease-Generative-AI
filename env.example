# Gemini API key from Google AI Studio
GEMINI_API_KEY=your_api_key_here

# Current Gemini model. The PDF specified gemini-1.5-pro, but that model was shut down.
GEMINI_MODEL=gemini-3.8-flash

# Backend URL used by Streamlit
BACKEND_URL=http://127.0.0.1:8000

# Set true only for local testing without a Gemini key.
MOCK_AI=false

# Comma-separated Streamlit origins allowed by FastAPI CORS.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
